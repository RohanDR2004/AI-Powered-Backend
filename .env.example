# PostgreSQL connection string (async driver, used by the FastAPI app)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_backend

# JWT settings
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI API (required for /ai/generate). Never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis (caching, rate limiting, Celery broker/backend)
REDIS_URL=redis://127.0.0.1:6379/0

# Security / environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_DOCS=true
