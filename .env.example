# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_backend

# JWT settings
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI API (required for /ai/generate). Never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
